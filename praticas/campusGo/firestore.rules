rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/tasks/{taskId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validTask(data) {
        return data.keys().hasOnly([
          'title', 'notes', 'completed', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid == userId
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.notes is string
        && data.notes.size() <= 240
        && data.completed is bool;
      }

      allow read: if isOwner();
      allow create: if isOwner() && validTask(request.resource.data);
      allow update: if isOwner()
        && resource.data.ownerUid == userId
        && validTask(request.resource.data);
      allow delete: if isOwner() && resource.data.ownerUid == userId;
    }
  }
}
